# Copy to .env and fill in real values. Never commit .env itself.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-value
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
# Used directly by docker-compose's db service, and parsed as a URL by Django via django-environ.
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=change-me
DATABASE_URL=psql://hms:change-me@db:5432/hms

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
